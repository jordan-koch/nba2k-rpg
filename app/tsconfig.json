{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",

    /* Strictness. The generated template sets NONE of these — it ships no
       `strict` and no `noUncheckedIndexedAccess` at all, which is exactly the
       "config that checks nothing" the negative typecheck exists to rule out.
       Never loosen one to make a build pass; fix the code. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force"
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["typecheck-fixtures", "dist", "node_modules"]
}
