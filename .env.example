# Copy to .env and fill in for your machine. .env is gitignored.
#
# This repo is PUBLIC. Nothing machine-specific — no absolute paths, no account
# ids, no tokens — belongs in a tracked file. tests/test_no_leaks.py enforces it.

# Where NBA 2K26 is installed: the folder containing the `manifest` file.
# Optional — research/tools/iff.ps1 probes the Steam registry entry and the
# common library locations first. Set this only if the probe fails, or if you
# want to point at a specific install.
NBA2K26_INSTALL=

# Reference checkouts, if you have them locally. Neither is a dependency —
# nothing in this repo reads either one. See ADR 0007.
NBA_ANALYSIS_PATH=
POKEMON_LAB_PATH=
